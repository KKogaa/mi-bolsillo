# =============================================================================
# Mi Bolsillo - Docker Compose Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION (Required for all backend services)
# =============================================================================
# Turso/LibSQL database URL
DATABASE_URL=libsql://your-database.turso.io
# Turso database authentication token
DATABASE_TOKEN=your-database-token

# =============================================================================
# AUTHENTICATION CONFIGURATION (Required for backend and frontend)
# =============================================================================
# Clerk JWKS URL for JWT verification (backend)
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# Clerk publishable key (frontend)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key

# =============================================================================
# AI/ML CONFIGURATION (Required for backend services)
# =============================================================================
# Grok API key for intent detection
GROK_API_KEY=your-grok-api-key

# =============================================================================
# TELEGRAM BOT CONFIGURATION (Required for telegram-bot service)
# =============================================================================
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Telegram Bot Username (for frontend)
VITE_TELEGRAM_BOT_USERNAME=your_bot_username_here

# =============================================================================
# EMAIL PROVIDER CONFIGURATION (Optional)
# =============================================================================
# Email service API URL
EMAIL_PROVIDER_URL=https://your-email-provider.com/api
# Email service authentication token
EMAIL_PROVIDER_TOKEN=your-email-token

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# API URL that frontend will connect to
# For local development with docker-compose, use http://localhost:8080
# For production, use your deployed API URL
VITE_API_URL=http://localhost:8080

# =============================================================================
# OTP CONFIGURATION (Optional)
# =============================================================================
# OTP expiration time in minutes (default: 5)
OTP_EXPIRATION_MINUTES=5

# =============================================================================
# USAGE INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in all required values above
#
# 3. Start all services:
#    docker-compose up -d
#
# 4. Start specific services:
#    docker-compose up -d echo-server frontend
#
# 5. View logs:
#    docker-compose logs -f
#
# 6. Stop all services:
#    docker-compose down
#
# 7. Rebuild after code changes:
#    docker-compose up -d --build
#
# =============================================================================
# SERVICE PORTS
# =============================================================================
# Echo Server (API): http://localhost:8080
# Frontend: http://localhost:3000
# Telegram Bot: No exposed port (uses long polling)
# =============================================================================
